PORT=3000
BASE_URL=http://localhost:3000
DATA_DIR=./data
# Set before exposing the app. HTTP Basic auth; use HTTPS in production.
APP_USER=admin
APP_PASSWORD=
# Defaults: global 2 concurrent jobs, 60 seconds between requests to one host
CONCURRENCY=2
HOST_DELAY_MS=60000
# SMTP email notifications (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PagePulse <alerts@example.com>
MAIL_TO=
# Discord webhook / Telegram bot credentials (optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DIGEST_HOUR_UTC=8
